{
  "name": "openforge",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev:db": "node ./scripts/openforge.mjs dev-db",
    "dev:db:down": "node ./scripts/openforge.mjs dev-db-down",
    "dev:db:reset": "node ./scripts/openforge.mjs dev-db-reset",
    "dev:api": "node ./scripts/openforge.mjs dev-api",
    "dev:web": "node ./scripts/openforge.mjs dev-web",
    "dev:all": "node ./scripts/openforge.mjs dev-all",
    "check": "node ./scripts/openforge.mjs check",
    "smoke": "node ./scripts/openforge.mjs smoke",
    "jar": "node ./scripts/openforge.mjs jar",
    "jar:smoke": "node ./scripts/openforge.mjs jar-smoke",
    "web:dev": "pnpm --filter web dev",
    "web:lint": "pnpm --filter web lint",
    "web:typecheck": "pnpm --filter web typecheck",
    "web:test": "pnpm --filter web test --run",
    "web:build": "pnpm --filter web build"
  }
}
