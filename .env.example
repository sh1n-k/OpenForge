# local | test | production (local/test 외에는 JWT secret 필수)
APP_ENV=local
APP_MODE=paper
API_PORT=8080
WEB_PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openforge
DB_USER=openforge
DB_PASSWORD=openforge
# 여러 OpenForge checkout을 동시에 실행할 때만 고유한 Compose 프로젝트명을 지정한다.
# COMPOSE_PROJECT_NAME=openforge-dev
WEB_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8080
# 로컬 Vite 개발 서버에서는 같은 origin의 /api 프록시를 사용한다.
# 프론트에서 API를 직접 호출해야 할 때만 VITE_API_BASE_URL을 지정한다.
# VITE_API_BASE_URL=http://127.0.0.1:8080
OPENFORGE_AUTH_PASSWORD=
OPENFORGE_JWT_SECRET=
LIVE_TRADING_ENABLED=false
LIVE_TRADING_MOCK_BROKER=true
LIVE_TRADING_ALLOW_LIVE_BROKER=false
LIVE_TRADING_MAX_ORDER_NOTIONAL=100000.000000
LIVE_TRADING_MAX_CONSECUTIVE_FAILURES=3
# 실제 KIS paper E2E 테스트를 명시적으로 실행할 때만 채운다. 값은 커밋하지 않는다.
RUN_KIS_PAPER_E2E=false
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIS_PRODUCT_CODE=
KIS_BASE_URL=
KIS_PAPER_SYMBOL=
KIS_PAPER_PRICE=
KIS_PAPER_EQUITY=
KIS_PAPER_CASH=
KIS_PAPER_TARGET_WEIGHT=1.0
KIS_PAPER_MAX_NOTIONAL=100000.0
